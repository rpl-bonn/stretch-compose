{
    "name": "ROS Development Container",
    // Compose mode: VS Code attaches to the "ros2-main" service defined in the
    // workspace-root docker-compose.yml (two levels up from this file).
    "dockerComposeFile": ["../../docker-compose.yml"],
    "service": "ros2-main",
    "workspaceFolder": "/home/ws",
    "remoteUser": "${localEnv:USERNAME}",
    // Only bring up this service on "Reopen in Container"; start the rest of the
    // stack (sam3, scene-graph) from the terminal when you need it.
    "runServices": ["ros2-main"],
    // Run the service's own command (sleep infinity) instead of overriding it.
    "overrideCommand": false,
    // Prevent auto-injection of features (they run before our setup and break it).
    "features": {},
    "overrideFeatureInstallOrder": [],
    "customizations": {
        "vscode": {
            "extensions":[
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros"
            ]
        }
    },
    "initializeCommand": "sh ./.devcontainer/initialize.sh",
    "postCreateCommand": "sh ./.devcontainer/postCreate.sh"
}
