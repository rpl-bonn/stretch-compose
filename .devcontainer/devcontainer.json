{
    "name": "ROS Development Container",
    "privileged": true,
    "remoteUser": "stretch",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "stretch",
            "DOCKER_REPO": "osrf/ros",
            "ROS_DISTRO": "humble",
            "IMAGE_SUFFIX": "-desktop-full"
        }
    },
    // Add this to prevent auto-injection of features  AI SLOP- prevents devcontainer to add stuff which breaks our code s it runs before our stuff
    "features": {},
    "overrideFeatureInstallOrder": [],

    "workspaceFolder": "/home/ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ws,type=bind",
    "customizations": {
        "vscode": {
            "extensions":[
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "${env:DISPLAY}",
        "ROS_LOCALHOST_ONLY": "0",
        "ROS_DOMAIN_ID": "1",
        "PYTHONPATH": "${PYTHONPATH}:/home/ws:/home/ws/source",
        "QT_X11_NO_MITSHM": "1",
        "LIBGL_ALWAYS_INDIRECT": "0",
        "NVIDIA_DRIVER_CAPABILITIES": "all",
        "NVIDIA_VISIBLE_DEVICES": "all"
    },
    "runArgs": [
        "--net=host",
        "-e", "DISPLAY=${localEnv:DISPLAY}",
        "--gpus", "all",
        "-e", "NVIDIA_DRIVER_CAPABILITIES=all",
        "-e", "NVIDIA_VISIBLE_DEVICES=all",
        "--device", "/dev/snd", 
        "-e", "PULSE_SERVER=unix:${localEnv:XDG_RUNTIME_DIR}/pulse/native",
        "-v", "${localEnv:XDG_RUNTIME_DIR}/pulse/native:${localEnv:XDG_RUNTIME_DIR}/pulse/native",
        "-v", "${localEnv:HOME}/.config/pulse/cookie:/root/.config/pulse/cookie",
        "-e", "XDG_RUNTIME_DIR=${localEnv:XDG_RUNTIME_DIR}",
        "-e", "XAUTHORITY=${localEnv:XAUTHORITY}"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.ssh,target=/home/stretch/.ssh,type=bind",
        "source=${localEnv:HOME}/.Xauthority,target=${localEnv:HOME}/.Xauthority,type=bind"
    ],
    "initializeCommand": "sh ./.devcontainer/initialize.sh",
    "postCreateCommand": "sh ./.devcontainer/postCreate.sh"
}
